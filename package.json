{
  "name": "pictochat",
  "homepage": "https://PezzottiCarlo.github.io/pictochat",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vocab": "node scripts/build-vocab.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "build:firebase": "tsc --noEmit && vite build --base=/",
    "deploy:firebase": "npm run build:firebase && npx firebase-tools deploy --only hosting"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.6.6",
    "big-integer": "^1.6.52",
    "buffer": "^6.0.3",
    "idb": "^8.0.4",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "telegram": "^2.26.22",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "gh-pages": "^6.2.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.0.5"
  }
}
